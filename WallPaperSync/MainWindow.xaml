<Window x:Class="Jnl.WallPaperSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Jnl.WallPaperSync"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="MainWindow_Loaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Capture" Click="Capture_Click"
                      ToolTip="Captures the current desktop wallpaper image." />
            <MenuItem Header="_Sync Lock Screen" Click="SyncLockScreen_Click"
                      ToolTip="Sets image as lockscreen background." />
        </Menu>
        <Grid>

        </Grid>
    </DockPanel>
</Window>
